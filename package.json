{
  "name": "unique-av-imix",
  "productName": "Unique AV IMix",
  "version": "1.0.0",
  "description": "Unique AV IMix – live video production switcher for macOS (inputs, transitions, overlays, titles, audio mixer, recording, streaming, replay, web/TCP API).",
  "main": "main.js",
  "author": "Unique AV",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:mac": "electron-builder --mac",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "test": "node test/browser-smoke.mjs",
    "test:electron": "xvfb-run -a node test/electron-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.uniqueav.imix",
    "productName": "Unique AV IMix",
    "copyright": "Copyright © Unique AV",
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Unique AV IMix uses your cameras as live video inputs.",
        "NSMicrophoneUsageDescription": "Unique AV IMix uses your microphones and audio interfaces as live audio inputs.",
        "NSScreenCaptureUsageDescription": "Unique AV IMix can capture your screen or windows as a live input."
      }
    },
    "dmg": {
      "title": "Unique AV IMix"
    }
  }
}
