{
  "name": "unique-av-recorder",
  "productName": "Unique AV Recorder",
  "version": "1.0.0",
  "description": "Unique AV Recorder – a basic video and audio recorder for Windows that records from capture cards, webcams and USB audio devices.",
  "main": "main.js",
  "author": "Unique AV",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "test": "node test/unit-ffmpeg.cjs",
    "test:electron": "node test/electron-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.uniqueav.recorder",
    "productName": "Unique AV Recorder",
    "copyright": "Copyright © Unique AV",
    "files": [
      "main.js",
      "preload.js",
      "ffmpeg.js",
      "renderer/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Unique-AV-Recorder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Unique-AV-Recorder-Portable-${version}.${ext}"
    }
  }
}
